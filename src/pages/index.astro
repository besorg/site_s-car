---
import Layout from '../layouts/Layout.astro';
---

<Layout title="S-Cars Detailing Premium">
  <section class="hero">
    <div class="hero-content">
      <div class="hero-column">
        <img src="/images/logo.png" alt="Logo S-Cars" class="hero-logo" />
      </div>

      <div class="hero-column">
        <h1>Detailing Premium a Domicilio</h1>

        <p>
          Servicio profesional de lavado y detailing para vehículos.
          Atendemos en countries, barrios privados y residencias particulares,
          ofreciendo comodidad, confianza y resultados de excelencia.
        </p>

        <a id="whatsapp-button" class="btn hero-btn" target="_blank">
          Solicitar Turno
        </a>
      </div>
    </div>
  </section>

  <section class="menu" id="menu">
    <h2>Servicios Premium</h2>

    <p class="menu-subtitle">
      Soluciones exclusivas para mantener tu vehículo impecable durante todo el año.
    </p>

    <div class="burger-list two-columns" id="burger-list"></div>
  </section>

  <section class="about" id="about">
    <h2>La Experiencia S-Cars</h2>

    <p>
      En S-Cars nos especializamos en car detailing y lavado premium a domicilio.
      Nuestro objetivo es ofrecer un servicio exclusivo para quienes valoran la
      imagen, el cuidado y la conservación de su vehículo.
    </p>

    <p>
      Trabajamos con productos profesionales y técnicas especializadas para lograr
      resultados superiores tanto en el exterior como en el interior del automóvil.
    </p>

    <p>
      Nos trasladamos hasta tu domicilio para brindarte una experiencia cómoda,
      segura y profesional, sin que tengas que modificar tu rutina.
    </p>
  </section>

  <section class="reviews" id="reviews">
    <h2>Clientes que Confían en Nosotros</h2>
    <div id="reviews-container" class="review-grid"></div>
  </section>

  <section class="cta-reserva cta-section">
    <h3 class="cta-message">
      Descubrí nuestros planes de mantenimiento premium y mantené tu vehículo
      impecable todos los días.
    </h3>

    <a
      class="btn"
      href="https://wa.me/5491132776974?text=Hola%20S-Cars,%20quisiera%20informaci%C3%B3n%20sobre%20sus%20servicios."
      target="_blank"
    >
      Consultar por WhatsApp
    </a>
  </section>

  <section class="contact" id="contact">
    <h2>Contacto</h2>

    <p>
      Consultanos por WhatsApp o Instagram para solicitar información,
      coordinar una visita o conocer nuestros planes de mantenimiento.
    </p>

    <div class="contact-methods">
      <a href="https://instagram.com/scarsdetailing" target="_blank">
        <img src="/images/instagram-icon.png" alt="Instagram" class="icon" />
      </a>

      <a id="wa-link" href="#" target="_blank">
        <img src="/images/whatsapp-icon.png" alt="WhatsApp" class="icon" />
      </a>
    </div>
  </section>

  <footer class="footer">
    <p>&copy; S-Cars Detailing Premium. Todos los derechos reservados.</p>

    <p>
      Sitio desarrollado por
      <a
        href="https://marketing-bso.netlify.app/"
        target="_blank"
        style="color: inherit; text-decoration: underline;"
      >
        BSO Web Studio
      </a>
    </p>
  </footer>

  <script>
    document.documentElement.classList.add('dark');
  </script>

  <script src="https://cdn.jsdelivr.net/npm/papaparse@5.4.1/papaparse.min.js" defer></script>
  <script src="/scripts/modal.js" defer></script>
  <script>
    window.addEventListener('DOMContentLoaded', () => {
      const baseId = '1GKFy-rpXx0ZuDoe55UZlqE2pwG4Zx1o8846zn8nAAJk';

      const urls = {
        menu: `https://docs.google.com/spreadsheets/d/${baseId}/gviz/tq?tqx=out:csv&sheet=Productos`,
        reviews: `https://docs.google.com/spreadsheets/d/${baseId}/gviz/tq?tqx=out:csv&sheet=Resenias`
      };

      function fetchCSV(url) {
        return fetch(url)
          .then(res => res.text())
          .then(csv => {
            const parsed = Papa.parse(csv, { header: false }).data;
            const headers = parsed[0].map(h => h.trim().toLowerCase());
            return parsed.slice(1).map(row => {
              const obj = {};
              headers.forEach((key, i) => {
                obj[key] = row[i]?.trim?.() ?? '';
              });
              return obj;
            });
          });
      }

      Promise.all([
        fetchCSV(urls.menu),
        fetchCSV(urls.reviews)
      ]).then(([menuRows, reviewsRows]) => {
        const whatsapp = '5491165565637';
        window.dynamicWhatsapp = whatsapp;

        const whatsappButton = document.getElementById('whatsapp-button');
        if (whatsappButton && whatsapp) {
          whatsappButton.href = `https://wa.me/${whatsapp}?text=${encodeURIComponent("¡Hola! Quiero agendar un turno.")}`;
        }

        const whatsappLink = document.getElementById('wa-link');
        if (whatsappLink && whatsapp) {
          whatsappLink.href = `https://wa.me/${whatsapp}?text=${encodeURIComponent("¡Hola! Quiero agendar un turno.")}`;
        }

        const products = menuRows
          .filter(row => row.nombre && row.imagen)
          .map(row => ({
            nombre: row.nombre,
            descripcion: row.descripcion,
            imagen: row.imagen
          }));
        window.dynamicProducts = products;


const list = document.getElementById('burger-list');
list.innerHTML = products.map((product) => `
  <div class="burger-card">
    <img src="${product.imagen}" alt="${product.nombre}" />
    <div class="card-content">
      <h3>${product.nombre}</h3>
      <p>${product.descripcion}</p>
    </div>
    <a class="btn" href="https://wa.me/5491165565637?text=${encodeURIComponent('¡Hola! Quisiera ' + product.nombre)}" target="_blank">Reservar</a>
  </div>
`).join('');

        const reviews = reviewsRows
  .filter(r => r.cita)
  .map(r => `
    <div class="review-card">
      <img src="${r.cita}" alt="Reseña" />
    </div>
  `);
        document.getElementById('reviews-container').innerHTML = reviews.join('');
      }).catch(err => {
        console.error("Error cargando los datos:", err);
      });
    });
  </script>
</Layout>
